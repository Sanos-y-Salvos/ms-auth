PORT=3001

# PostgreSQL — usado por la app
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=ms_auth

# Broker — cola de eventos desde ms-users (Bull sobre Redis)
REDIS_BROKER_URL=redis://localhost:6379

# Redis cache propio — perfiles cacheados para /api/auth/me
REDIS_CACHE_URL=redis://localhost:6379

# JWT — debe coincidir con ms-users
JWT_SECRET=CHANGE_ME_JWT_SECRET

# API key interna — debe coincidir con ms-users
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

NODE_ENV=development
